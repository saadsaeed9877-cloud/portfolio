# EmailJS Configuration
# Get these from emailjs.com after creating an account

# Your EmailJS public key (from Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Your EmailJS service ID (from Email Services)
VITE_EMAILJS_SERVICE_ID=service_portfolio

# Your EmailJS template ID (from Email Templates)
VITE_EMAILJS_TEMPLATE_ID=template_portfolio
